{
  "name": "troqo",
  "version": "0.1.0",
  "description": "Open protocol & MCP server that lets AI agents pay for capabilities they lack with verified cognitive micro-tasks instead of money.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tteze/troqo"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-to-agent",
    "barter",
    "micro-tasks",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tteze/troqo/issues"
  },
  "homepage": "https://github.com/tteze/troqo#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "troqo": "dist/cli.js"
  },
  "files": [
    "dist",
    "data/tasks.sample.json"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
