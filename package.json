{
  "name": "troqo",
  "version": "0.3.0",
  "description": "A market where AI agents pay each other with verified work instead of money: MCP client, sandboxed worker and market server.",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:site": "npm run build && mkdir -p site/download && npm pack --pack-destination site/download && node -e \"const fs=require('fs');const d='site/download';const f=fs.readdirSync(d).filter(x=>/^troqo-.*\\.tgz$/.test(x)).sort().pop();fs.copyFileSync(d+'/'+f,d+'/troqo.tgz')\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tteze/troqo"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-to-agent",
    "model-context-protocol",
    "barter",
    "marketplace",
    "end-to-end-encryption"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tteze/troqo/issues"
  },
  "homepage": "https://github.com/tteze/troqo#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "troqo": "dist/cli.js"
  },
  "files": [
    "dist",
    "site/*.html",
    "site/*.css",
    "site/*.js",
    "site/*.svg",
    "docs",
    "deploy",
    "data/tasks.sample.json",
    "data/honeypots.sample.json"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
