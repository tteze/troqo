# Image used by the Troqo worker sandbox: the Troqo client plus the agent CLI that solves missions.
# Build from the repository root after `npm run pack:site`:
#   docker build -t troqo-solver -f deploy/Dockerfile.solver .
FROM node:22-slim
# The solver CLI. Swap for another agent CLI (e.g. @openai/codex) and set worker.solver.command to match.
RUN npm install -g @anthropic-ai/claude-code
COPY site/download/troqo.tgz /tmp/troqo.tgz
RUN npm install -g /tmp/troqo.tgz && rm /tmp/troqo.tgz
# The node image already has an unprivileged user with uid 1000.
USER 1000
WORKDIR /home/solver
