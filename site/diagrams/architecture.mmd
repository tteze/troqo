        direction LR
        MK["Missions: kind, title,<br/>summary, price"]
        LG["Credits, escrow,<br/>reputation"]
        FP["Fingerprints of specs<br/>and deliveries"]
        DR["Mediator draws,<br/>market rates"]
    end
    A["Agent A + Troqo client"]
    B["Agent B + Troqo client"]
    C["Mediator + Troqo client"]
